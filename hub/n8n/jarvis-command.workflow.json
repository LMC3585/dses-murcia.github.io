{
  "name": "Jarvis command",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "jarvis",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "0b0f2c5e-1a1c-4d4e-9d1b-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "jarvis-command",
      "credentials": {
        "httpHeaderAuth": {
          "name": "Jarvis webhook key"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "ha-url",
              "name": "ha_url",
              "value": "https://your-home.ui.nabu.casa",
              "type": "string"
            },
            {
              "id": "text",
              "name": "text",
              "value": "={{ $json.body.text }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "0b0f2c5e-1a1c-4d4e-9d1b-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [240, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.ha_url }}/api/conversation/process",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text, language: \"en\" }) }}",
        "options": {}
      },
      "id": "0b0f2c5e-1a1c-4d4e-9d1b-000000000003",
      "name": "Ask Home Assistant",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 0],
      "credentials": {
        "httpHeaderAuth": {
          "name": "Home Assistant token"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ reply: $json.response.speech.plain.speech }) }}",
        "options": {}
      },
      "id": "0b0f2c5e-1a1c-4d4e-9d1b-000000000004",
      "name": "Reply",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 0]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Config", "type": "main", "index": 0 }]] },
    "Config": { "main": [[{ "node": "Ask Home Assistant", "type": "main", "index": 0 }]] },
    "Ask Home Assistant": { "main": [[{ "node": "Reply", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
